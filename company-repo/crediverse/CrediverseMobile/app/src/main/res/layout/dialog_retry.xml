<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Warning Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠"
                android:textSize="40sp"
                android:layout_marginBottom="12dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/retry_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_config_failed_title"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Message -->
            <TextView
                android:id="@+id/retry_dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feature_config_failed_message"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Retry Button -->
            <TextView
                android:id="@+id/retry_dialog_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@color/warn"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:text="@string/retry"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
